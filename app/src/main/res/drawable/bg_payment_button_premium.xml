<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Disabled state -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#E0E0E0"
                android:endColor="#BDBDBD"
                android:type="linear"/>
            <corners android:radius="16dp"/>
            <stroke
                android:width="1dp"
                android:color="#9E9E9E"/>
        </shape>
    </item>
    
    <!-- Enabled state - Professional gold gradient like free badge -->
    <item android:state_enabled="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#FFFEF7"
                android:endColor="#FFF8E1"
                android:type="linear"/>
            <corners android:radius="16dp"/>
            <stroke
                android:width="2dp"
                android:color="#FFD54F"/>
        </shape>
    </item>
</selector>
