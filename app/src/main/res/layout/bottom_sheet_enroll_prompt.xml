<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet">

    <!-- Golden Sparkling Background -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Sparkle 1 - Top Left -->
        <ImageView
            android:id="@+id/sparkle1"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_sparkle_gold"
            android:alpha="0.6"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            android:layout_marginStart="30dp"
            android:layout_marginTop="40dp"/>

        <!-- Sparkle 2 - Top Right -->
        <ImageView
            android:id="@+id/sparkle2"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_sparkle_gold"
            android:alpha="0.5"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="50dp"
            android:layout_marginTop="80dp"/>

        <!-- Sparkle 3 - Mid Left -->
        <ImageView
            android:id="@+id/sparkle3"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_sparkle_gold"
            android:alpha="0.7"
            android:layout_alignParentStart="true"
            android:layout_marginStart="60dp"
            android:layout_marginTop="180dp"/>

        <!-- Sparkle 4 - Bottom Right -->
        <ImageView
            android:id="@+id/sparkle4"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_sparkle_gold"
            android:alpha="0.4"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="40dp"
            android:layout_marginTop="220dp"/>

        <!-- Fine Particles - Additional sparkles for magical effect -->
        <ImageView
            android:id="@+id/particle1"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_sparkle_gold"
            android:alpha="0.3"
            android:layout_marginStart="80dp"
            android:layout_marginTop="60dp"/>

        <ImageView
            android:id="@+id/particle2"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="@drawable/ic_sparkle_gold"
            android:alpha="0.4"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="70dp"
            android:layout_marginTop="120dp"/>

        <ImageView
            android:id="@+id/particle3"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_sparkle_gold"
            android:alpha="0.5"
            android:layout_marginStart="120dp"
            android:layout_marginTop="150dp"/>

        <ImageView
            android:id="@+id/particle4"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:src="@drawable/ic_sparkle_gold"
            android:alpha="0.3"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="100dp"
            android:layout_marginTop="200dp"/>

        <ImageView
            android:id="@+id/particle5"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_sparkle_gold"
            android:alpha="0.6"
            android:layout_marginStart="40dp"
            android:layout_marginTop="250dp"/>

        <ImageView
            android:id="@+id/particle6"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_sparkle_gold"
            android:alpha="0.4"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="30dp"
            android:layout_marginTop="280dp"/>

        <ImageView
            android:id="@+id/particle7"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="@drawable/ic_sparkle_gold"
            android:alpha="0.5"
            android:layout_marginStart="150dp"
            android:layout_marginTop="100dp"/>

        <ImageView
            android:id="@+id/particle8"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_sparkle_gold"
            android:alpha="0.4"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="120dp"
            android:layout_marginTop="50dp"/>

        <ImageView
            android:id="@+id/particle9"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:src="@drawable/ic_sparkle_gold"
            android:alpha="0.3"
            android:layout_marginStart="100dp"
            android:layout_marginTop="300dp"/>

        <ImageView
            android:id="@+id/particle10"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_sparkle_gold"
            android:alpha="0.5"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="60dp"
            android:layout_marginTop="160dp"/>

        <ImageView
            android:id="@+id/particle11"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="@drawable/ic_sparkle_gold"
            android:alpha="0.4"
            android:layout_marginStart="180dp"
            android:layout_marginTop="240dp"/>

        <ImageView
            android:id="@+id/particle12"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_sparkle_gold"
            android:alpha="0.6"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="90dp"
            android:layout_marginTop="320dp"/>

    </RelativeLayout>

    <!-- Main Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Lock Icon with Gradient Background -->
        <androidx.cardview.widget.CardView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center_horizontal"
            app:cardCornerRadius="40dp"
            app:cardElevation="12dp"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="#FFD700">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_lock_closed"
                app:tint="#000000"/>

        </androidx.cardview.widget.CardView>

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Unlock Premium Content"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="8dp"/>

        <!-- Course Name -->
        <TextView
            android:id="@+id/tvCourseName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Course Name"
            android:textSize="16sp"
            android:textColor="?attr/colorOnSurface"
            android:alpha="0.7"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <!-- Pricing Card -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_golden_gradient"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Enroll for just"
                        android:textSize="12sp"
                        android:textColor="#000000"
                        android:alpha="0.7"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹399"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:textColor="#000000"/>

                        <TextView
                            android:id="@+id/tvOriginalPrice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹499"
                            android:textSize="16sp"
                            android:textColor="#000000"
                            android:alpha="0.5"
                            android:layout_marginStart="8dp"
                            android:visibility="gone"/>

                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/tvDiscount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="20% OFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:background="@drawable/bg_golden_gradient"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:visibility="gone"/>

            </LinearLayout>

        </FrameLayout>

        <!-- Course Features -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="What's Included:"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="12dp"/>

        <!-- Features List (Dynamic) -->
        <LinearLayout
            android:id="@+id/llFeatures"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">
            <!-- Features will be added dynamically -->
        </LinearLayout>

        <!-- Enroll Now Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEnrollNow"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Enroll Now"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#000000"
            app:cornerRadius="28dp"
            android:elevation="6dp"
            app:icon="@drawable/ic_arrow_forward"
            app:iconGravity="end"
            app:iconTint="#FFFFFF"
            android:layout_marginBottom="12dp"/>

        <!-- Maybe Later Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMaybeLater"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Maybe Later"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurface"
            android:backgroundTint="@android:color/transparent"
            app:strokeColor="?attr/colorOnSurface"
            app:strokeWidth="1dp"
            app:cornerRadius="24dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

    </LinearLayout>

</FrameLayout>
