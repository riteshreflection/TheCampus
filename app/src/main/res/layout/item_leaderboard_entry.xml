<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp">
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?attr/colorSurface"
        android:padding="16dp">
        
        <!-- Top Row: Rank + User Info + Points -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            
            <!-- Rank Section -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="12dp">
                
                <TextView
                    android:id="@+id/rankIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="28sp"
                    tools:text="👑" />
                
                <TextView
                    android:id="@+id/rankBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="@android:color/white"
                    tools:text="#1"
                    tools:background="@drawable/bg_rank_gold" />
            </LinearLayout>
            
            <!-- Avatar -->
            <androidx.cardview.widget.CardView
                android:layout_width="56dp"
                android:layout_height="56dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#F5F7FA">
                
                <TextView
                    android:id="@+id/avatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary"
                    tools:text="N" />
            </androidx.cardview.widget.CardView>
            
            <!-- User Name & Champion Badge -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    
                    <TextView
                        android:id="@+id/displayName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:textColor="?attr/colorOnBackground"
                        android:maxLines="1"
                        android:ellipsize="end"
                        tools:text="Nikita Choudhary" />
                    
                    <TextView
                        android:id="@+id/championBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:text="👑"
                        android:textSize="11sp"
                        android:background="@drawable/bg_champion_badge"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>
                
                <!-- Streak Badge (if exists) -->
                <TextView
                    android:id="@+id/streakIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#FF6B35"
                    android:background="@drawable/bg_streak_badge"
                    android:visibility="gone"
                    tools:text="⚡ 6 day streak"
                    tools:visibility="visible" />
            </LinearLayout>
            
            <!-- Points/Metric Value -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end"
                android:layout_marginStart="8dp">
                
                <TextView
                    android:id="@+id/metricValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textSize="22sp"
                    android:textColor="?attr/colorPrimary"
                    tools:text="2,057" />
                
                <TextView
                    android:id="@+id/metricLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="?attr/colorOnBackground"
                    tools:text="points" />
            </LinearLayout>
        </LinearLayout>
        
        <!-- Bottom Row: Stats -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginStart="68dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            
            <TextView
                android:id="@+id/level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="?attr/colorOnBackground"
                tools:text="Level 14" />
            
            <View
                android:layout_width="3dp"
                android:layout_height="3dp"
                android:layout_gravity="center_vertical"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/bg_circle_gray" />
            
            <TextView
                android:id="@+id/totalTests"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="?attr/colorOnBackground"
                tools:text="40 tests" />
            
            <View
                android:layout_width="3dp"
                android:layout_height="3dp"
                android:layout_gravity="center_vertical"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/bg_circle_gray" />
            
            <TextView
                android:id="@+id/averageScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="?attr/colorOnBackground"
                tools:text="85.5%" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
