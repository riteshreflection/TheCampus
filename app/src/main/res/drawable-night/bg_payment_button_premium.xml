<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Disabled state for dark mode -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#424242"
                android:endColor="#303030"
                android:type="linear"/>
            <corners android:radius="16dp"/>
            <stroke
                android:width="1dp"
                android:color="#616161"/>
        </shape>
    </item>
    
    <!-- Enabled state - Dark mode gold gradient -->
    <item android:state_enabled="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#3D3520"
                android:endColor="#2D2818"
                android:type="linear"/>
            <corners android:radius="16dp"/>
            <stroke
                android:width="2dp"
                android:color="#5D4F28"/>
        </shape>
    </item>
</selector>
